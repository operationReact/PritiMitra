# Export these in your shell (or your IDE run configuration). Do not commit real values.
# Matches infra/.env. Use the same user and password as Docker Compose.
DB_URL=jdbc:postgresql://localhost:5432/pritimitra
DB_USERNAME=pritimitra
DB_PASSWORD=change-me-locally

# Amazon Cognito (JWT validation only; the API never calls Cognito sign-in).
# Use the development user pool outputs from `terraform output`. Placeholders below are not real.
AWS_REGION=ap-south-1
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/<user-pool-id>
COGNITO_USER_POOL_ID=<user-pool-id>
COGNITO_CLIENT_IDS=<app-client-id>

# Legal policy versions. Local drafts are allowed only with PRITIMITRA_LEGAL_REQUIRE_APPROVED=false.
PRITIMITRA_TERMS_VERSION=terms-draft-v1
PRITIMITRA_PRIVACY_VERSION=privacy-draft-v1
PRITIMITRA_TERMS_URL=
PRITIMITRA_PRIVACY_URL=
# Defaults to true (fail closed). Local development sets false to allow draft versions. Production must keep true.
PRITIMITRA_LEGAL_REQUIRE_APPROVED=false

# Retention for INELIGIBLE (underage) accounts, and the purge schedule (Spring cron, 6 fields).
PRITIMITRA_INELIGIBLE_RETENTION_DAYS=30
PRITIMITRA_PURGE_CRON=0 17 3 * * *
