# Public, non-secret values for the web app. Copy to .env.local for local overrides.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-only auth configuration. Use placeholders here; put real values in .env.local (never commit them).
COGNITO_REGION=<aws-region, e.g. ap-south-1>
# Not used by the web auth flows (they need only the client ID); kept for backend parity.
COGNITO_USER_POOL_ID=<user-pool-id>
COGNITO_CLIENT_ID=<web-app-client-id-without-secret>
# Server-only origin of the Spring Boot API. Must be https in production.
BACKEND_API_BASE_URL=http://localhost:8080
